&pinctrl {
	/* configure uart pins
	 * 2-wire link to the nRF54L15 (TX/RX only). RTS/CTS are intentionally
	 * NOT routed: the boards are connected with only two jumpers, so enabling
	 * hardware flow control would leave CTS floating/pulled-high ("not clear
	 * to send") and block all TX. Keep this in sync with the 54 overlay.
	 */
	uart2_default: uart2_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 29)>; // P0.29 for TX
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 28)>; // P0.28 for RX
			bias-pull-up;
		};
	};

	uart2_sleep: uart2_sleep {
		/* configure uart pins for sleep mode */
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 29)>,
				<NRF_PSEL(UART_RX, 0, 28)>;
			low-power-enable;
		};
	};
};

/* 2-wire UART to the nRF54L15 gateway (no hardware flow control) */
&uart2 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart2_default>;
	pinctrl-1 = <&uart2_sleep>;
	pinctrl-names = "default", "sleep";
};

&gpio0 {
	status = "okay";
	/* Use PORT event for DTR (8) pin to save power */
	sense-edge-mask = <0x00000100>;
};

/* Disable I2C2.
 * - Enabling IO expander causes ~20uA to be consumed while DTR is deasserted.
 * - We use P0.31 and P0.30 pins for DTR and RI signals with external MCU.
 */
&i2c2 {
	status = "disabled";
};

/* Enable external flash */
&gd25wb256 {
	status = "okay";
};

